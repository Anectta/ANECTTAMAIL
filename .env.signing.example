# Copie este arquivo para `.env.signing` (ignorado pelo Git) ao assinar builds locais.
# NUNCA faça commit de certificados .pfx/.p12 ou senhas no repositório!

# --- OPÇÃO 1: Certificado .pfx / .p12 (arquivo local ou Base64 no CI) ---
# CSC_LINK=C:\certs\anectta-codesign.pfx
# CSC_KEY_PASSWORD=sua-senha-do-certificado

# --- OPÇÃO 2: Token USB EV / Windows Certificate Store (ex.: DigiCert / SafeNet / Certum) ---
# WIN_CERT_SHA1=THUMBPRINT_SHA1_DO_CERTIFICADO
# WIN_CERT_SUBJECT_NAME=Anectta Enterprise

# --- Servidor de Carimbo de Tempo (RFC 3161 SHA-256) ---
WIN_TIMESTAMP_URL=http://timestamp.digicert.com

# Defina como true em pipelines de produção para impedir builds sem assinatura:
REQUIRE_CODE_SIGNING=false
